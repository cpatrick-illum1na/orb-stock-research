# Copy this file to .env and enter PAPER credentials locally.
# Never commit .env or share its contents.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Historical default: SIP. Free IEX is available for the IEX feed.
ORB_DEFAULT_FEED=sip
ORB_DEFAULT_ADJUSTMENT=raw

# Optional: use an alternate uvx executable path if it is not on PATH.
ALPACA_MCP_COMMAND=uvx
ALPACA_MCP_PACKAGE=alpaca-mcp-server
